# Copy this file to the deployed application's .env and set real values there.
# PostgreSQL must be a server service; never put a SQLite DB on a NAS share.
DATABASE_URL=postgresql+psycopg://ky_app:CHANGE_ME@db-server:5432/ky_history

# UNC path. Grant the users read/write access to this folder; use a service
# account for PostgreSQL separately. Do not use a mapped drive letter.
PHOTO_STORAGE_DIR=\\nas-server\KY写真解析\data\photos

# Used only until a future login integration supplies the authenticated user.
# Leave blank to record the Windows sign-in name automatically.
DEFAULT_CREATED_BY=
